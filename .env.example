# Copy the variables you need into your shell environment (or a local .env file, which is git-ignored).

# daily-news-email
NEWS_API_KEY=your-newsapi-key

# weather-forecast-dashboard
OPENWEATHER_API_KEY=your-openweather-key

# daily-news-email, portfolio-website (Gmail requires an App Password)
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# student-management-mysql
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=school

# job-application-flask (optional; a random key is generated if unset)
FLASK_SECRET_KEY=change-me

# job-application-django, restaurant-menu-django (optional; a random key is generated if unset)
DJANGO_SECRET_KEY=change-me
